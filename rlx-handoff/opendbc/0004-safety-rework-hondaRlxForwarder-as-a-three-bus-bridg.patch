+def expected_fwd_bus(bus: int, addr: int) -> int:
+  if bus == BUS_CAMERA:
+    return -1 if addr in STEER_CMD_ADDRS else BUS_EPS
+  if bus == BUS_EPS:
+    return BUS_PT if addr in EPS_STATUS_ADDRS else BUS_CAMERA
+  if bus == BUS_PT:
+    return BUS_EPS if addr in STEER_CMD_ADDRS else -1
+  return -1
 
 
