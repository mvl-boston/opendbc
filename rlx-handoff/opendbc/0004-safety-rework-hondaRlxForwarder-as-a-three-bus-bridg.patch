-static int honda_rlx_forwarder_steer_bus = 2;
+#define HONDA_RLX_FWD_BUS_EPS 0
+#define HONDA_RLX_FWD_BUS_PT 1
+#define HONDA_RLX_FWD_BUS_CAMERA 2
 
